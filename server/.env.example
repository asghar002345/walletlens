# Copy to server/.env for local dev. Never commit .env. No value here is a real secret.

# --- Core ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Local mongod / docker compose, or a free Atlas M0 URI (no card needed)
MONGODB_URI=mongodb://127.0.0.1:27017/walletlens
# Long random string, generate your own: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Mode ---
# true (default) = fully offline: fixture chain data, mocked LLM + embeddings, no keys needed.
MOCK_MODE=true

# --- Public testnet RPCs (optional; viem's public defaults are used if empty) ---
SEPOLIA_RPC_URL=
AMOY_RPC_URL=

# --- Provider keys (live mode only, added in later milestones; free tiers only) ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# --- Rate limits / free-tier guards (conservative defaults) ---
API_RATE_WINDOW_MS=60000
API_RATE_MAX=60
RPC_PER_MINUTE=60
RPC_PER_DAY=5000
GROQ_PER_MINUTE=10
GROQ_PER_DAY=500
GEMINI_PER_MINUTE=5
GEMINI_PER_DAY=200
GEMINI_EMBED_PER_MINUTE=30
GEMINI_EMBED_PER_DAY=500
TX_CACHE_TTL_SEC=86400
