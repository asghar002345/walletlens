{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.evals.json",
    "test": "vitest run",
    "dev:memory": "tsx src/devMemory.ts",
    "seed:knowledge": "tsx src/seedKnowledge.ts",
    "eval": "tsx evals/run.ts",
    "eval:fixtures": "tsx evals/build-fixtures.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.4",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
